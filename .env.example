DATABASE_URL="postgresql://user:password@localhost:5432/workout_tracker"

# The one account that always has the OWNER role — seeded/promoted on every
# deploy (see prisma/seed.ts). Only ever one OWNER; everyone else signs up
# via the magic-link flow at /login.
OWNER_EMAIL="you@example.com"

# Generate both with: openssl rand -base64 32
# Email is encrypted at rest (EMAIL_ENCRYPTION_KEY, AES-256-GCM) with a
# separate HMAC blind index for lookups (EMAIL_HMAC_KEY) — see
# src/lib/email-crypto.ts. Keep these two DIFFERENT from each other.
EMAIL_ENCRYPTION_KEY=""
EMAIL_HMAC_KEY=""

# Resend (https://resend.com) sends the magic-link emails. If unset, the
# link is logged to the server console instead — this is the local-dev
# path; only set these on the production environment (see README).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lifting Log <login@yourdomain.example>"
